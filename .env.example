# microJBase development environment placeholders.
# Copy to .env for local development only; never commit a real .env.
# See ARCHITECTURE.md "Configuration" for the full variable contract.

# Restricted runtime role used by the API.
DATABASE_URL=postgres://microjbase:microjbase_dev_password@127.0.0.1:5432/microjbase_dev

# Optional privileged role used by the migration command only.
MIGRATION_DATABASE_URL=postgres://microjbase_admin:replace_me@127.0.0.1:5432/microjbase_dev

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
SESSION_TTL_SECONDS=604800

# Data API alias mappings; required when exposing tables.
MICROJBASE_TABLES=todos=public.todos

TRUST_PROXY=false
MAX_BODY_BYTES=1048576
